R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=R4SNES
VERSION=0.19.0
LANGUAGE=Zig
SOURCE=src/main.zig
ENTRY_MODE=app
APP_CLASS=gui
MODULE_ROLE=subsystem
SUBSYSTEM_ID=r4os.snes
SUBSYSTEM_DISPLAY_NAME=Super Nintendo
GUEST_FORMAT=snes.cartridge
GUEST_EXTENSION=snes.cartridge:.sfc
GUEST_EXTENSION=snes.cartridge:.smc
GUEST_FEATURE=snes.cartridge:binary.rom
TARGET=/R4OS/SUBSYSTEMS/r4os.snes/R4SNES.R4X
IMAGE_SCOPE=full
OPTIMIZE=speed
IMPORT=R4SYS:Query:1
IMPORT=R4DESK:Query:1
IMPORT=R4DRAW:Query:1
IMPORT=R4AUDIO:Query:1
